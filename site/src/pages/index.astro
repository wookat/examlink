---
import DemoStage from "../components/DemoStage.vue";
import "../styles/landing.css";

const logoSvg = `<svg viewBox="0 0 24 24" width="26" height="26"><defs><linearGradient id="lgx" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#818cf8"/><stop offset="1" stop-color="#a78bfa"/></linearGradient></defs><rect x="1.5" y="1.5" width="21" height="21" rx="6" fill="url(#lgx)"/><path d="M9 10.4V8.6c0-.5.4-.9.9-.9h1.7M15.4 7.7h-1.7a.9.9 0 0 0-.9.9v1.8M9 13.6v1.8c0 .5.4.9.9.9h1.7M15.4 16.3h-1.7a.9.9 0 0 1-.9-.9v-1.8" stroke="#fff" stroke-width="1.5" stroke-linecap="round" fill="none"/><circle cx="12" cy="12" r="1.7" fill="#fff"/></svg>`;

const features = [
  {
    t: "自动截题",
    d: "基线差分检测屏幕变化：渐变翻页也能抓住，时钟光标不误报。框选题目区域后几乎零误触。",
    icon: '<path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3.5"/>',
  },
  {
    t: "真实题号",
    d: "本地 OCR 读取屏幕上的「第 N 题」，卡片题号与试卷一致——不用猜答到第几题。离线运行，可关闭。",
    icon: '<path d="M4 7V4h16v3M9 20h6M12 4v16"/>',
  },
  {
    t: "题卡轮播",
    d: "当前题居中放大，左右露出相邻题答案。滚轮、滑动、点击都能翻题，扫一眼就知道「18 题选 C」。",
    icon: '<rect x="8" y="4" width="8" height="16" rx="2"/><path d="M1 8h4M19 8h4M1 16h4M19 16h4"/>',
  },
  {
    t: "多模态 AI",
    d: "OpenAI 兼容 / Gemini / Claude 等视觉模型直读截图，支持代理与浏览器直连两种通道，双模型交叉校验答案。",
    icon: '<path d="M12 2l2.4 7.2H22l-6 4.4 2.3 7.4-6.3-4.6-6.3 4.6L8 13.6 2 9.2h7.6z"/>',
  },
  {
    t: "知识库秒答",
    d: "命中的题目直接返回库内答案，不过模型、毫秒级出结果；新答案自动回写，越用越快。",
    icon: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
  },
  {
    t: "安全底线",
    d: "只读屏幕、只出答案：从不自动填写、从不点击提交。考试机全程不失焦，所有操作都在第二屏完成。",
    icon: '<path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="M9 11.5l2 2 4-4.5"/>',
  },
];

const steps = [
  { n: "01", t: "考试机运行", d: "单文件 exe，纯 Python 内核。启动后在局域网广播一个带 token 的链接。" },
  { n: "02", t: "第二屏打开", d: "手机或另一台电脑浏览器访问链接，进入实时答题页——就是上方演示的界面。" },
  { n: "03", t: "自动出答案", d: "屏幕换题自动截图送答，题号 OCR 对齐试卷；也可手动截图、输入框追问。" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>examlink — 第二屏答题助手</title>
    <meta name="description" content="examlink：运行在考试机上的局域网服务，把 AI 答案实时呈现在手机或第二台电脑上。自动截题、真实题号、题卡轮播，绝不自动填写或提交。" />
    <link rel="icon" href={'data:image/svg+xml,' + encodeURIComponent(logoSvg)} />
  </head>
  <body>
    <nav class="nav">
      <div class="wrap nav-in">
        <a class="nav-brand" href="#top" set:html={logoSvg + '<span>exam<em>link</em></span>'} />
        <div class="nav-links">
          <a href="#demo">演示</a>
          <a href="#features">功能</a>
          <a href="#how">原理</a>
          <a class="nav-gh" href="https://github.com/wookat/examlink" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
            GitHub
          </a>
        </div>
      </div>
    </nav>

    <header class="hero" id="top">
      <div class="wrap">
        <div class="hero-kicker">局域网服务 · 第二屏呈现 · 多模态 AI</div>
        <h1>答案，出现在<br /><span class="grad">第二块屏幕</span>上</h1>
        <p class="hero-sub">
          examlink 运行在考试电脑上：盯住屏幕换题、自动截图、交给视觉大模型。
          你在手机或另一台电脑的浏览器里，看到题目和答案实时浮现——考试机全程不需要你碰。
        </p>
        <div class="hero-cta">
          <a class="btn primary" href="#demo">看实时演示 ↓</a>
          <a class="btn" href="https://github.com/wookat/examlink" target="_blank" rel="noopener">获取单文件 exe</a>
        </div>
        <div class="hero-meta">
          <span>纯 Python 后端</span><i />
          <span>Vue 3 + TS 前端</span><i />
          <span>本地 OCR 题号</span><i />
          <span>不自动填写 · 不自动提交</span>
        </div>
      </div>
    </header>

    <section class="demo-sec" id="demo">
      <div class="wrap">
        <div class="sec-head">
          <h2>这不是截图，是<span class="grad">真机</span></h2>
          <p>下方就是产品的真实前端，正在模拟一场笔试：自动截题 → 流式作答 → 题卡入堆。点击画面后即可滚轮翻题、点侧卡跳题、用底栏追问。</p>
        </div>
        <div class="demo-box">
          <DemoStage client:only="vue" />
        </div>
      </div>
    </section>

    <section class="features" id="features">
      <div class="wrap">
        <div class="sec-head">
          <h2>为考场场景<span class="grad">打磨</span></h2>
          <p>检测、识别、呈现，每一环都按「不能出错、不能被注意」的标准设计。</p>
        </div>
        <div class="feat-grid">
          {features.map(f => (
            <div class="feat-card">
              <div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} /></div>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="how" id="how">
      <div class="wrap">
        <div class="sec-head">
          <h2>三步<span class="grad">上线</span></h2>
          <p>没有安装向导、没有账号体系，跑起来就是一个链接。</p>
        </div>
        <div class="step-grid">
          {steps.map(s => (
            <div class="step-card">
              <div class="step-n">{s.n}</div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
        <div class="arch">
          <div class="arch-node">
            <b>考试电脑</b>
            <span>截屏差分 · OCR 题号 · 调用模型</span>
            <code>examlink.exe</code>
          </div>
          <div class="arch-link">
            <span>局域网 / 热点</span>
            <div class="arch-line" />
            <em>WebSocket + token</em>
          </div>
          <div class="arch-node">
            <b>手机 / 第二台电脑</b>
            <span>浏览器打开链接即可</span>
            <code>实时答题页</code>
          </div>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap foot-in">
        <div class="foot-brand" set:html={logoSvg + '<span>exam<em>link</em></span>'} />
        <p>第二屏答题助手 · 只读屏幕，只出答案</p>
        <a href="https://github.com/wookat/examlink" target="_blank" rel="noopener">github.com/wookat/examlink</a>
      </div>
    </footer>
  </body>
</html>
